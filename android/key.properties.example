# Modèle pour la signature de release Android.
# 1) Copier ce fichier en "key.properties" (même dossier android/).
# 2) Générer un keystore (une seule fois) :
#    keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# 3) Renseigner les valeurs ci-dessous. NE JAMAIS versionner key.properties ni le .jks.

storePassword=VOTRE_MOT_DE_PASSE_STORE
keyPassword=VOTRE_MOT_DE_PASSE_CLE
keyAlias=upload
# Chemin vers le keystore (absolu, ou relatif au dossier android/app)
storeFile=../upload-keystore.jks
